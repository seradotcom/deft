  "metadata": {
    "id": "legacybank.open-sub-account",
    "name": "Open a sub-account for a member",
    "description": "Signs into LegacyBank core, opens the member record, fills the new sub-account form (type, nickname, initial deposit), reviews, and confirms the irreversible opening through the native confirmation dialog.",
    "version": "2.0.0",
    "status": "needs-review",
    "createdAt": "2026-08-24T00:21:17.639Z",
    "updatedAt": "2026-08-25T00:00:00.000Z"
  },
  "target": {
    "appFamily": "legacybank",
    "surfaceType": "web-legacy",
    "entryUrlTemplate": "http://localhost:7788/acme/login.aspx",
    "variants": []
  },
  "inputs": {
    "type": "object",
    "required": [
      "memberId",
      "nickname",
      "deposit"
    ],
    "additionalProperties": false,
    "properties": {
      "memberId": {
        "type": "string",
        "title": "Member ID",
        "pattern": "^M[0-9]+$"
      },
      "nickname": {
        "type": "string",
        "title": "Account nickname",
        "minLength": 1
      },
      "deposit": {
        "type": "string",
        "title": "Initial deposit in USD (numeric)",
        "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
      }
    }
  },

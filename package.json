{
  "name": "deft",
  "version": "0.1.0",
  "description": "DEFT — the model discovers, the capability replays. Computer-use automation: LLM-driven discovery on a live UI, compiled into a typed, versioned capability artifact that replays deterministically with no model in the loop.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:submission": "node scripts/verify-submission.mjs",
    "target:start": "node dist/targets/legacybank/server.js",
    "agent:discover": "node dist/cli/index.js discover",
    "replay": "node dist/cli/index.js replay",
    "capabilities": "node dist/cli/index.js capabilities"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "express": "^5.2.1",
    "playwright": "^1.58.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

